PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=connecta_vet

JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Sessão por cookie httpOnly + refresh token (2.2) ---
# Vida útil do access token (JWT curto). Aceita "15m", "1h", etc.
ACCESS_TOKEN_TTL=15m
# Vida útil do refresh token, em dias (janela de "manter conectado").
REFRESH_TOKEN_TTL_DAYS=30
# Origin do front para o CORS com credenciais (NÃO pode ser '*').
CORS_ORIGIN=http://localhost:3000
# Cookies de sessão. Em produção com front e API em domínios diferentes:
#   COOKIE_SECURE=true e COOKIE_SAMESITE=none (exige HTTPS).
# Em dev (http/localhost) mantenha secure=false e samesite=lax.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Domínio dos cookies (ex.: .conectavet.com.br p/ compartilhar subdomínios).
# Deixe em branco em dev.
COOKIE_DOMAIN=

PAGARME_SECRET_KEY=
PAGARME_PUBLIC_KEY=

# Segredo compartilhado para as rotas do bot do WhatsApp (header X-Bot-Key).
# Sem ele, as rotas /users/by-cpf e /users/register-from-whatsapp ficam bloqueadas.
BOT_API_KEY=

MAX_UPLOAD_MB=10